# Configuration of the SuperCI launcher for GCP. install.sh writes this file to /etc/superci-launcher.env (root-owned, mode
# 0600) when that file does not exist, and refuses to start the launcher while a value below still holds a <placeholder>.
#
# Systemd reads this file, not a shell: one VARIABLE=value per line, no spaces around the =, no `export`, no variable
# substitution, and a comment is a whole line that starts with #. Do not put double quotes around a value.

# The GCP project that holds the job VMs (required).
PROJECT=<project-id>

# The region of the job VMs, not of this launcher VM (required). The design puts the job VMs in us-west4.
REGION=<region>

# The zones to try in the region, in order, comma-separated (optional). Empty means <REGION>-a,<REGION>-b,<REGION>-c.
ZONES=

# The VPC network of the job VMs (required), not the launcher VM's.
NETWORK=<network-name>

# The subnet of the job VMs in REGION (required): a bare name, or a path such as projects/<project>/regions/<region>/subnetworks/<name>.
SUBNET=<subnet-name>

# The image family of the runner image that image/build-image.sh writes (required).
IMAGE_FAMILY=superci-runner

# The GitHub runner version the image was built with, for example 2.338.2 (required; a job VM logs a notice when its runner differs).
RUNNER_VERSION=<runner-version>

# 1 starts one on-demand VM when no spot room is found; anything else, 0 included, is off (optional).
ON_DEMAND_FALLBACK=0

# The launcher's URL exactly as it is registered with the control plane (required): https:// followed by the NAME given to
# install.sh. It is the audience of the plane's tokens, so a different spelling is refused with 401.
PUBLIC_URL=https://<name>

# The control plane's URL, character for character as the `iss` claim of its tokens has it (required).
TRUSTED_ISSUER=<plane-url>

# The control plane's subject, plane: followed by the plane id (required), for example plane:abc123def456.
TRUSTED_SUBJECT=plane:<plane-id>

# The control plane's public keys, its JWKS, as JSON on one line (required). Make the line with
#   curl -s <plane-url>/.well-known/jwks.json | jq -c .
# (without jq, `tr -d '\n'` in place of `jq -c .` also gives one line) and paste it in place of the placeholder. Keep the
# single quotes around it: they keep the JSON's own double quotes as they are.
TRUSTED_KEYS='<jwks-json-on-one-line>'

# The shared secret of POST /sweep (required): superci-launcher-sweep.timer, which install.sh sets up, sends it in the header
# x-superci-sweep every ten minutes, and /sweep answers 404 to anything else. Make one with `openssl rand -hex 24` and paste
# its output here; keep to hex digits, because systemd treats $ and % in a command line specially.
SWEEP_SECRET=<output-of-openssl-rand-hex-24>

# 1 on path B, where API Gateway sits in front of the launcher; leave it 0 on path A (optional).
BEHIND_GATEWAY=0

# 0 on path B, where the job VMs have no external address; leave it 1 on path A (optional).
EXTERNAL_ADDRESS=1
